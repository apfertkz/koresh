# Обязательное
ANTHROPIC_API_KEY=sk-ant-...
WEBHOOK_SECRET=сгенерируй_длинную_случайную_строку   # входит в адрес вебхука; пусто = вебхук закрыт

# Мозг и характер
MODEL=claude-sonnet-5-5                # по умолчанию; быстрее/дешевле: claude-haiku-5-5 (haiku-4-5 не знает EFFORT)
EFFORT=low                             # глубина размышления: low | medium | high | xhigh | max; мусор = low
ASSISTANT_NAME=Кореш                   # имя, тон, пол, HOUSEHOLD, BLOCKED_NAMES, ALLOW_LOCKS, LOCK_PHRASE, YANDEX_IOT_TOKEN можно задать на /setup; переменная главнее страницы
TONE=derzkiy                           # derzkiy_mat | derzkiy | vezhlivyy
GENDER=male                            # род ассистента о себе, под голос навыка: male (мужской голос) | female (голос Алисы); мусор = male
HOUSEHOLD={"owner":"Имя","people":{"Айгуль":"жена"},"rooms":{"детская":"Комната Али"}}

# Долгая память (на Railway: Volume с mount path /data + переменная RAILWAY_RUN_UID=0)
MEMORY_DIR=/data                       # заметки о человеке, пересказы разговоров, суточный счётчик; недоступен = память только до перезапуска
MEMORY_MODEL=claude-haiku-5-5          # дешёвая модель для пересказа разговоров (после ответа, Алису не задерживает)

# Умный дом
YANDEX_IOT_TOKEN=y0_...                # OAuth со скоупами iot:view iot:control. НЕОБЯЗАТЕЛЬНО: проще вставить на странице /setup (тогда лежит в MEMORY_DIR/config.json); переменная главнее config.json

# WhatsApp (необязательно): 0 = выключить совсем; сессия и контакты лежат в MEMORY_DIR/wa, настраивается на /setup
WA_ENABLED=

# Страница настройки /setup (мастер на 8 шагов; без SETUP_CODE страницы нет)
SETUP_CODE=                            # одноразовый код входа; Railway генерирует сам; после установки удалить
YANDEX_OAUTH_CLIENT_ID=                # ClientID общего приложения «Кореш» (кнопка «Войти через Яндекс»); секрет приложения не нужен
INSTALL_CALLBACK_URL=                  # куда сообщить «установлено» после шага «Готово» (необязательно)
INSTALL_TOKEN=                         # токен установки вида <публичная часть>.<секрет>: подписывает это сообщение (HMAC-SHA256)
PUBLIC_URL=                            # необязательно: публичный адрес, если /setup показывает не тот адрес вебхука

# Потолки и защита
DAILY_TOKEN_CAP=300000                 # токенов в сутки (UTC), 0 = без потолка
ALLOW_LOCKS=                           # 1 = разрешить замки/ворота/сигнализацию
LOCK_PHRASE=                           # кодовая фраза; без неё ALLOW_LOCKS не работает
BLOCKED_NAMES=                         # доп. защищённые слова через запятую
HOLD_TIMEOUT=3.8
